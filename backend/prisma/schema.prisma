// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sessions     Session[]
}

model Patient {
  id Int @id @default(autoincrement())

  name String
  cpf String? 
  cpfHash String? @unique

  phone String

  birthDate DateTime
  treatmentStartDate DateTime

  diagnosticHypothesis String?

  hasMedicalFollowUp Boolean @default(false)
  doctorName String?

  generalNotes String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  medications PatientMedication[]
  medicalRecordEntries MedicalRecordEntry[]
  appointments Appointment[]
}

model PatientMedication {
  id Int @id @default(autoincrement())

  name String
  notes String?

  isActive Boolean @default(true)

  startedAt DateTime @default(now())
  endedAt DateTime?

  patientId Int
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
}

model MedicalRecordEntry {
  id Int @id @default(autoincrement())

  patientId Int
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  type MedicalRecordEntryType

  entryDate DateTime
  content String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([patientId, entryDate])
}

enum MedicalRecordEntryType {
  APPOINTMENT
  GENERAL_NOTE
}

model Appointment {
  id Int @id @default(autoincrement())

  patientId Int
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  startAt DateTime
  endAt   DateTime

  status AppointmentStatus @default(SCHEDULED)

  confirmed Boolean @default(false)

  notes String?

  recurrenceId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([startAt])
  @@index([status])
  @@index([recurrenceId])
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Session {
  id        Int      @id @default(autoincrement())

  tokenHash String   @unique

  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt      DateTime @default(now())
  lastActivityAt DateTime @default(now())
  expiresAt      DateTime

  @@index([userId])
  @@index([expiresAt])
}